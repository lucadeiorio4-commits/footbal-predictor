
name: Aggiorna dati calcistici

on:
  workflow_dispatch:
  schedule:
    - cron: "17 */6 * * *"

permissions:
  contents: write

jobs:
  aggiorna:
    runs-on: ubuntu-latest

    steps:
      - name: Scarica repository
        uses: actions/checkout@v4

      - name: Prepara Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Scarica e unisci i calendari
        run: |
          python - <<'PY'
          import json
          import urllib.request
          from datetime import datetime, timezone
          from pathlib import Path

          HEADERS = {
              "User-Agent": "FootballPredictorAI/1.0"
          }

          SOURCES = [
              (
                  "Italian Serie A 2026/27",
                  "https://raw.githubusercontent.com/openfootball/football.json/master/2026-27/it.1.json",
                  "openfootball"
              ),
              (
                  "Champions League 2026/27",
                  "https://fixturedownload.com/feed/json/champions-league-2026",
                  "fixture"
              ),
              (
                  "Europa League 2026/27",
                  "https://fixturedownload.com/feed/json/europa-league-2026",
                  "fixture"
              ),
              (
                  "Conference League 2026/27",
                  "https://fixturedownload.com/feed/json/conference-league-2026",
                  "fixture"
              )
          ]

          def download_json(url):
              request = urllib.request.Request(url, headers=HEADERS)
              with urllib.request.urlopen(request, timeout=40) as response:
                  return json.loads(response.read().decode("utf-8"))

          def convert_openfootball(data, competition):
              matches = []

              for item in data.get("matches", []):
                  date_value = item.get("date", "")
                  time_value = item.get("time", "")

                  home = item.get("team1", "")
                  away = item.get("team2", "")

                  if not home or not away or not date_value:
                      continue

                  score = item.get("score") or {}
                  ft = score.get("ft") if isinstance(score, dict) else None

                  home_score = None
                  away_score = None

                  if isinstance(ft, list) and len(ft) >= 2:
                      home_score, away_score = ft[0], ft[1]

                  matches.append({
                      "campionato": competition,
                      "giornata": str(item.get("round", "Da definire")),
                      "data": date_value,
                      "ora": time_value or "",
                      "casa": home,
                      "ospite": away,
                      "risultatoCasa": home_score,
                      "risultatoOspite": away_score
                  })

              return matches

          def convert_fixture_download(data, competition):
              matches = []

              for item in data:
                  date_raw = item.get("DateUtc", "")
                  if not date_raw:
                      continue

                  try:
                      dt = datetime.fromisoformat(
                          date_raw.replace("Z", "+00:00")
                      )
                      if dt.tzinfo is not None:
                          dt = dt.astimezone(timezone.utc)
                      date_value = dt.strftime("%Y-%m-%d")
                      time_value = dt.strftime("%H:%M")
                  except ValueError:
                      continue

                  home = item.get("HomeTeam", "")
                  away = item.get("AwayTeam", "")

                  if not home or not away:
                      continue

                  home_score = item.get("HomeTeamScore")
                  away_score = item.get("AwayTeamScore")

                  # Non considerare conclusa una partita futura
                  if dt.replace(tzinfo=timezone.utc) > datetime.now(timezone.utc):
                      home_score = None
                      away_score = None

                  matches.append({
                      "campionato": competition,
                      "giornata": "Giornata " + str(item.get("RoundNumber", "?")),
                      "data": date_value,
                      "ora": time_value,
                      "casa": home,
                      "ospite": away,
                      "risultatoCasa": home_score,
                      "risultatoOspite": away_score
                  })

              return matches

          all_matches = []
          successful_competitions = []

          for competition, url, source_type in SOURCES:
              try:
                  data = download_json(url)

                  if source_type == "openfootball":
                      converted = convert_openfootball(data, competition)
                  else:
                      converted = convert_fixture_download(data, competition)

                  if not converted:
                      raise ValueError("Nessuna partita valida ricevuta")

                  all_matches.extend(converted)
                  successful_competitions.append(competition)

                  print(f"OK: {competition}: {len(converted)} partite")

              except Exception as error:
                  print(f"ERRORE per {competition}: {error}")
                  raise

          expected = len(SOURCES)
          if len(successful_competitions) != expected:
              raise SystemExit(
                  f"Attese {expected} competizioni, "
                  f"ricevute {len(successful_competitions)}"
              )

          all_matches.sort(
              key=lambda match: (
                  match["data"],
                  match["ora"],
                  match["campionato"],
                  match["casa"]
              )
          )

          output = {
              "fonte": "OpenFootball + Fixture Download",
              "campionato": "Calendari europei 2026/27",
              "ultimoAggiornamento": datetime.now(
                  timezone.utc
              ).isoformat(),
              "numeroPartite": len(all_matches),
              "competizioni": successful_competitions,
              "partite": all_matches
          }

          destination = Path("data/fixtures.json")
          destination.parent.mkdir(parents=True, exist_ok=True)
          destination.write_text(
              json.dumps(output, ensure_ascii=False, indent=2),
              encoding="utf-8"
          )

          print(f"Totale: {len(all_matches)} partite")
          print(f"Competizioni: {len(successful_competitions)}")
          PY

      - name: Verifica calendario generato
        run: |
          python - <<'PY'
          import json

          with open("data/fixtures.json", encoding="utf-8") as file:
              data = json.load(file)

          matches = data.get("partite", [])
          competitions = {
              match.get("campionato")
              for match in matches
              if match.get("campionato")
          }

          print("Partite:", len(matches))
          print("Competizioni:", sorted(competitions))

          if not matches or len(competitions) != 4:
              raise SystemExit("ERRORE: calendario incompleto")

          required = [
              "Italian Serie A 2026/27",
              "Champions League 2026/27",
              "Europa League 2026/27",
              "Conference League 2026/27"
          ]

          missing = set(required) - competitions
          if missing:
              raise SystemExit(f"Competizioni mancanti: {missing}")

          print("Verifica completata.")
          PY

      - name: Salva i dati nel repository
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/fixtures.json

          if git diff --cached --quiet; then
            echo "Nessuna modifica ai dati."
          else
            git commit -m "Aggiorna calendari calcistici"
            git push
          fi
